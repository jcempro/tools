{
  "schema": 1,
  "id": "declaracoes-unificada",
  "document": {
    "headerTemplate": "${documentos} APLICA-SE A TODAS AS CONTAS PJ/PF DO(S) DECLARANTE(S). Página ${paginaAtual} de ${totalPaginas}",
    "background": "#d9d9d9",
    "paddingCm": 0.35
  },
  "footer": {        
    "intro": "Esta(s) autorização(ões)/declaração(ões) e adesão(ões) é(são) realizada(s)/assinada(s) física e/ou eletronicamente por",
    "personTemplate": "${numero} ${nome}, inscrito sob CPF nº ${documento}",
    "companyTemplate": "${numero} ${nome}, inscrito sob CNPJ nº ${documento}${representantes}",
    "representationTemplate": ", representada por ${representantes}",
    "representativeJoin": " e/ou ",
    "signature": "(assinaturas e visto/s)",
    "signatureReserveCm": 1,
    "indexBackground": "#cccccc",
    "indexPaddingCm": 0.3,
    "indexMarginCm": 0.3
  },
  "defaults": {
    "city": "Pirassununga",
    "uf": "SP"
